  "item": [
    {
      "name": "Подготовка данных",
      "item": [
        {
          "name": "Создать владельца события",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now());",
                  "const date = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
                  "const pad = value => String(value).padStart(2, '0');",
                  "const eventDate = date.getUTCFullYear() + '-' + pad(date.getUTCMonth() + 1) + '-' + pad(date.getUTCDate()) + ' ' + pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes()) + ':' + pad(date.getUTCSeconds());",
                  "pm.collectionVariables.set('eventDate', eventDate);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('ownerId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Event owner\",\n  \"email\": \"owner-{{runId}}@mail.ru\"\n}"
            },
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Создать автора комментария",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('authorId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comment author\",\n  \"email\": \"author-{{runId}}@mail.ru\"\n}"
            },
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Создать другого пользователя",
