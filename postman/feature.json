            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Comments {{runId}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "Создать событие",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('eventId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotation\": \"Event created for comments testing\",\n  \"category\": {{categoryId}},\n  \"description\": \"Detailed description of an event created for comments testing\",\n  \"eventDate\": \"{{eventDate}}\",\n  \"location\": {\"lat\": 55.75, \"lon\": 37.61},\n  \"paid\": false,\n  \"participantLimit\": 0,\n  \"requestModeration\": false,\n  \"title\": \"Comments test event\"\n}"
            },
            "url": "{{baseUrl}}/users/{{ownerId}}/events"
          }
        }
      ]
    },
    {
      "name": "Комментарии",
      "item": [
